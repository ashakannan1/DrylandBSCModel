Pnet_lich = Pg_lich - RD_lich,
# --- TOTAL BSC ---
Pg_BSC   = Pg_moss   + Pg_cyano   + Pg_lich,
RD_BSC   = RD_moss   + RD_cyano   + RD_lich,
Pnet_BSC = Pnet_moss + Pnet_cyano + Pnet_lich
) %>%
ungroup()
cat("done")
# -------------------------------------------------------------------------
# DAILY SUMMARIES
# -------------------------------------------------------------------------
model_daily <- model_output %>%
mutate(date = as.Date(datetime)) %>%
group_by(date, year, month) %>%
summarise(
GPP_daily        = sum(GPP_DT    * 0.021618, na.rm=TRUE),
Pg_moss_daily    = sum(Pg_moss   * 0.021618, na.rm=TRUE),
RD_moss_daily    = sum(RD_moss   * 0.021618, na.rm=TRUE),
Pnet_moss_daily  = sum(Pnet_moss * 0.021618, na.rm=TRUE),
Pg_cyano_daily   = sum(Pg_cyano  * 0.021618, na.rm=TRUE),
RD_cyano_daily   = sum(RD_cyano  * 0.021618, na.rm=TRUE),
Pnet_cyano_daily = sum(Pnet_cyano* 0.021618, na.rm=TRUE),
Pg_lich_daily    = sum(Pg_lich   * 0.021618, na.rm=TRUE),
RD_lich_daily    = sum(RD_lich   * 0.021618, na.rm=TRUE),
Pnet_lich_daily  = sum(Pnet_lich * 0.021618, na.rm=TRUE),
Pg_BSC_daily     = sum(Pg_BSC   * 0.021618, na.rm=TRUE),
RD_BSC_daily     = sum(RD_BSC   * 0.021618, na.rm=TRUE),
Pnet_BSC_daily   = sum(Pnet_BSC * 0.021618, na.rm=TRUE),
.groups = "drop"
)
# -------------------------------------------------------------------------
# MONTHLY CLIMATOLOGY
# -------------------------------------------------------------------------
model_monthly <- model_daily %>%
group_by(month) %>%
summarise(
GPP_mean         = mean(GPP_daily,        na.rm=TRUE),
Pg_moss_mean     = mean(Pg_moss_daily,    na.rm=TRUE),
Pg_cyano_mean    = mean(Pg_cyano_daily,   na.rm=TRUE),
Pg_lich_mean     = mean(Pg_lich_daily,    na.rm=TRUE),
Pg_BSC_mean      = mean(Pg_BSC_daily,     na.rm=TRUE),
Pnet_moss_mean   = mean(Pnet_moss_daily,  na.rm=TRUE),
Pnet_cyano_mean  = mean(Pnet_cyano_daily, na.rm=TRUE),
Pnet_lich_mean   = mean(Pnet_lich_daily,  na.rm=TRUE),
Pnet_BSC_mean    = mean(Pnet_BSC_daily,   na.rm=TRUE),
.groups = "drop"
) %>%
mutate(
moss_frac_GPP  = Pg_moss_mean  / GPP_mean,
cyano_frac_GPP = Pg_cyano_mean / GPP_mean,
lich_frac_GPP  = Pg_lich_mean  / GPP_mean,
BSC_frac_GPP   = Pg_BSC_mean   / GPP_mean
)
# -------------------------------------------------------------------------
# PLOTS
# -------------------------------------------------------------------------
# 1. Stacked BSC contribution to ecosystem GPP by month
model_monthly %>%
select(month, moss_frac_GPP, cyano_frac_GPP, lich_frac_GPP) %>%
pivot_longer(-month, names_to="type", values_to="frac") %>%
mutate(type = recode(type,
moss_frac_GPP  = "Moss",
cyano_frac_GPP = "Cyanobacteria",
lich_frac_GPP  = "Lichen"
)) %>%
ggplot(aes(x=month, y=frac, fill=type)) +
geom_col() +
scale_x_continuous(breaks=1:12, labels=month.abb) +
scale_y_continuous(labels=scales::percent) +
scale_fill_manual(values=c("Moss"="darkgreen", "Cyanobacteria"="steelblue", "Lichen"="goldenrod")) +
labs(y="Fraction of ecosystem GPP", x="Month", fill="BSC Type",
title="Biocrust contribution to ecosystem GPP") +
theme_classic()
# 2. Daily timeseries for a single year
model_daily %>%
filter(year == 2014) %>%
ggplot(aes(x=date)) +
geom_line(aes(y=GPP_daily), color="black", alpha=0.5) +
geom_line(aes(y=Pg_BSC_daily), color="darkgreen", linewidth=1) +
geom_hline(yintercept=0, linetype="dotted", color="gray50") +
labs(y="gC m⁻² day⁻¹", x=NULL, title="Ecosystem GPP vs Total BSC GPP (2014)") +
theme_classic()
# 3. Monthly climatology — all three BSC types
model_monthly %>%
select(month, Pg_moss_mean, Pg_cyano_mean, Pg_lich_mean, GPP_mean) %>%
pivot_longer(-c(month, GPP_mean), names_to="type", values_to="Pg") %>%
mutate(type = recode(type,
Pg_moss_mean  = "Moss",
Pg_cyano_mean = "Cyanobacteria",
Pg_lich_mean  = "Lichen"
)) %>%
ggplot(aes(x=month, y=Pg, color=type)) +
geom_line(linewidth=1.1) +
geom_line(aes(y=GPP_mean), color="black", linetype="dashed", linewidth=0.8) +
scale_x_continuous(breaks=1:12, labels=month.abb) +
scale_color_manual(values=c("Moss"="darkgreen", "Cyanobacteria"="steelblue", "Lichen"="goldenrod")) +
labs(y="gC m⁻² day⁻¹", x="Month", color="BSC Type",
title="Mean seasonal GPP by BSC type") +
theme_classic()
# 4. Daily BSC GPP and Respiration timeseries (2016)
model_daily %>%
filter(year == 2016) %>%
ggplot(aes(x = date)) +
geom_line(aes(y = Pg_BSC_daily,   color = "Daily BSC GPP"), linewidth = 0.8) +
geom_line(aes(y = -RD_BSC_daily,  color = "Daily BSC R"),   linewidth = 0.8, linetype = "dashed") +
geom_hline(yintercept = 0, linetype = "dotted", color = "gray50") +
scale_color_manual(values = c("Daily BSC GPP" = "darkgreen", "Daily BSC R" = "tomato3")) +
labs(x = NULL, y = expression(C~Assimilation~(gC~m^-2~d^-1)),
title = "Total BSC GPP and Respiration integrated daily (2016)",
color = NULL) +
theme_classic(base_size = 13)
# 5. Mean daily BSC fraction of ecosystem GPP (climatology)
model_output %>%
mutate(date     = as.Date(datetime),
month_day = format(date, "%m-%d")) %>%
group_by(month_day) %>%
summarise(
Pg_daily  = mean(Pg_BSC  * 0.021618 * 48, na.rm = TRUE),
GPP_daily = mean(GPP_DT  * 0.021618 * 48, na.rm = TRUE),
BSC_frac  = Pg_daily / GPP_daily * 100,
.groups = "drop"
) %>%
mutate(date = as.Date(paste0("2016-", month_day))) %>%
ggplot(aes(x = date, y = BSC_frac)) +
geom_line(color = "darkgreen", linewidth = 0.8) +
geom_hline(yintercept = 0, linetype = "dotted", color = "gray50") +
scale_x_date(date_labels = "%b", date_breaks = "1 month") +
labs(x = NULL, y = "Total BSC GPP (% of ecosystem GPP)",
title = "Mean daily total BSC contribution to ecosystem GPP") +
theme_classic(base_size = 13)
model_monthly %>%
select(month, moss_frac_GPP, cyano_frac_GPP, lich_frac_GPP) %>%
pivot_longer(-month, names_to="type", values_to="frac") %>%
mutate(type = recode(type,
moss_frac_GPP  = "Moss",
cyano_frac_GPP = "Cyanobacteria",
lich_frac_GPP  = "Lichen"
)) %>%
ggplot(aes(x=month)) +
geom_col(aes(y=frac, fill=type)) +
geom_line(data=model_monthly, aes(y=GPP_mean / max(GPP_mean) * max(BSC_frac_GPP)),
color="black", linewidth=1, linetype="dashed") +
scale_x_continuous(breaks=1:12, labels=month.abb) +
scale_y_continuous(labels=scales::percent) +
scale_fill_manual(values=c("Moss"="darkgreen", "Cyanobacteria"="steelblue", "Lichen"="goldenrod")) +
labs(y="Fraction of ecosystem GPP", x="Month", fill="BSC Type",
title="Biocrust contribution to ecosystem GPP") +
theme_classic()
# Load packages -----------------------------------------------------------
library(tidyverse)
library(readxl)
library(cmocean)
library(dplyr)
library(ggthemes)
library(ggplot2)
library(zoo)
library(here)
library(stringr)
# load in temperature files -----------------------------------------------
setwd("/Users/ashakannan/Library/CloudStorage/OneDrive-Personal/Desktop/thesis/caninervis")
CANA <- read_excel("2025-10-24-CANA_temp.xlsx", skip=14)
CANB <- read_excel("2025-11-03-CANB_temp.xlsx", skip=14)
CANC <- read_excel("2025-11-06-CANC_temp.xlsx", skip=14)
CAND <- read_excel("2025-11-13-CAND_temp.xlsx", skip=14)
CANE <- read_excel("2025-11-17-CANE_temp.xlsx", skip=14)
CANF <- read_excel("2025-11-20-CANF_temp.xlsx", skip=14)
# Cleaning ----------------------------------------------------------------
CANA <- CANA %>%
filter(LeakPct==0) %>%
mutate(delta_Tair = abs(Tair - lag(Tair)),
env_change = delta_Tair > 0.3) %>%
mutate(change_id = cumsum(replace_na(env_change, FALSE))+1) %>%
group_by(change_id) %>%
mutate(time_since_change = elapsed - first(elapsed)) %>%
ungroup()
# Rolling Slope -----------------------------------------------------------
rolling_slope <- function(x, y, width = 7) {
rollapplyr(1:length(y), width, function(i) {
coef(lm(y[i] ~ x[i]))[2]
}, fill = NA)
}
CANA <- CANA %>%
group_by(change_id) %>%
mutate(slope=rolling_slope(time_since_change, A_scaled)) %>%
ungroup()
CANA <- CANA %>%
filter(slope>-0.000008 & slope<0.000008) #%>%
# 3. Monthly climatology — all three BSC types
model_monthly %>%
select(month, Pg_moss_mean, Pg_cyano_mean, Pg_lich_mean, GPP_mean) %>%
pivot_longer(-c(month, GPP_mean), names_to="type", values_to="Pg") %>%
mutate(type = recode(type,
Pg_moss_mean  = "Moss",
Pg_cyano_mean = "Cyanobacteria",
Pg_lich_mean  = "Lichen"
)) %>%
ggplot(aes(x=month, y=Pg, color=type)) +
geom_line(linewidth=1.1) +
geom_line(aes(y=GPP_mean), color="black", linetype="dashed", linewidth=0.8) +
scale_x_continuous(breaks=1:12, labels=month.abb) +
scale_color_manual(values=c("Moss"="darkgreen", "Cyanobacteria"="steelblue", "Lichen"="goldenrod")) +
labs(y="gC m⁻² day⁻¹", x="Month", color="BSC Type",
title="Mean seasonal GPP by BSC type") +
theme_classic()
# 6. Side by side ecosystem and BSC GPP
model_monthly %>%
select(month, Pg_moss_mean, Pg_cyano_mean, Pg_lich_mean, Pg_BSC_mean, GPP_mean) %>%
pivot_longer(-month, names_to = "type", values_to = "Pg") %>%
mutate(
panel = ifelse(type == "GPP_mean", "Ecosystem GPP", "BSC GPP"),
label=recode(type,
Pg_moss_mean = "Moss crust",
Pg_cyano_mean = "Cyanobacteria crust",
Pg_lich_mean = "Lichen crust",
Pg_BSC_mean = "Total BSC",
GPP_mean = "Ecosystem GPP"),
alpha_val = ifelse(type == "Pg_BSC_mean", 1, ifelse(type == "GPP_mean", 1, 0.3)),
lwd_val   = ifelse(type %in% c("Pg_BSC_mean", "GPP_mean"), 1.3, 0.9)
) %>%
ggplot(aes(x=month, y=Pg, color=label, alpha=alpha_val, linewidth = lwd_val)) +
geom_line() +
facet_wrap(~panel, ncol=2, scales="free_y") +
scale_x_continuous(breaks=1:12, labels=month.abb) +
scale_color_manual(values=c(
"Moss crust" = "#4CB817",
"Cyanobacteria crust" = "#2E1503",
"Lichen crust" = "goldenrod",
"Total BSC" = "darkgreen",
"Ecosystem GPP" = "black"
)) +
scale_alpha_identity() +
scale_linewidth_identity() +
labs(y="gC m⁻² day⁻¹", x = "Month", color = NULL,
title = "Mean seasonal GPP") +
theme_classic() +
theme(legend.position="bottom")

# 3. Water response — all three overlaid
water_curve_all <- tibble(WC = wc_seq) %>%
mutate(
`Moss crust` = ifelse(WC < 0.05/max(model_output$SWC_moss,  na.rm=TRUE), 0,
(low_water_response_fxn(WC=WC, WC_k=WC_k_moss, Pgmax=1) *
high_water_response_fxn(WC=WC, slope=slope_moss,
intercept=intercept_moss, Pgmax=1)) / WC_scale_moss),
`Cyanobacteria crust` = ifelse(WC < 0.05/max(model_output$SWC_cyano, na.rm=TRUE), 0,
(low_water_response_fxn(WC=WC, WC_k=WC_k_cyano, Pgmax=1) *
high_water_response_fxn(WC=WC, slope=slope_cyano,
intercept=intercept_cyano, Pgmax=1)) / WC_scale_cyano),
`Lichen crust` = ifelse(WC < 0.05/max(model_output$SWC_lich,  na.rm=TRUE), 0,
calc_WC_frac_lich(WC))
) %>%
pivot_longer(-WC, names_to="type", values_to="WC_frac")
# 3. Water response — all three overlaid

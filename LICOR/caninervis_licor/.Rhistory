water_curve_all <- tibble(WC = wc_seq) %>%
mutate(
`Moss crust` = ifelse(WC < 0.05/max(model_output$SWC_moss,  na.rm=TRUE), 0,
(low_water_response_fxn(WC=WC, WC_k=WC_k_moss, Pgmax=1) *
high_water_response_fxn(WC=WC, slope=slope_moss,
intercept=intercept_moss, Pgmax=1)) / WC_scale_moss),
`Cyanobacteria crust` = ifelse(WC < 0.05/max(model_output$SWC_cyano, na.rm=TRUE), 0,
(low_water_response_fxn(WC=WC, WC_k=WC_k_cyano, Pgmax=1) *
high_water_response_fxn(WC=WC, slope=slope_cyano,
intercept=intercept_cyano, Pgmax=1)) / WC_scale_cyano),
`Lichen crust` = ifelse(WC < 0.05/max(model_output$SWC_lich,  na.rm=TRUE), 0,
calc_WC_frac_lich(WC))
) %>%
pivot_longer(-WC, names_to="type", values_to="WC_frac")
p_water <- ggplot(water_curve_all, aes(x=WC, y=WC_frac, color=type)) +
geom_line(linewidth=1.2) +
scale_color_manual(values=bsc_colors) +
labs(x="Relative Water Content", y=expression(P[frac]),
color=NULL) +
theme_classic(base_size=13) +
theme(legend.position="bottom")
# 2-col layout — temp and light on top row, water centered below
fig_ecophys <- (p_temp | p_light) / (p_water | plot_spacer()) +
plot_annotation(
title = "BSC ecophysiology response curves",
theme = theme(plot.title = element_text(size=16, face="bold"))
) +
plot_layout(guides="collect") &
theme(legend.position="bottom")
fig_ecophys
p4 <- ggplot(env_monthly, aes(x=month, y=mean_T)) +
geom_line(color="#F44336", linewidth=1.2) +
geom_point(color="#F44336", size=2) +
scale_x_continuous(breaks=1:12, labels=month.abb) +
labs(x=NULL, y="Soil T (°C)") +
theme_classic(base_size=13)
env_monthly <- model_input %>%
group_by(month) %>%
summarise(
mean_T   = mean(SOILT_O_5, na.rm=TRUE),
mean_PAR = mean(PPFD_IN, na.rm=TRUE),
mean_SWC = mean(SWC_O_5, na.rm=TRUE),
.groups  = "drop"
)
p4 <- ggplot(env_monthly, aes(x=month, y=mean_T)) +
geom_line(color="#F44336", linewidth=1.2) +
geom_point(color="#F44336", size=2) +
scale_x_continuous(breaks=1:12, labels=month.abb) +
labs(x=NULL, y="Soil T (°C)") +
theme_classic(base_size=13)
p4
p5 <- ggplot(env_monthly, aes(x=month, y=mean_PAR)) +
geom_line(color="#FFC107", linewidth=1.2) +
geom_point(color="#FFC107", size=2) +
scale_x_continuous(breaks=1:12, labels=month.abb) +
labs(x=NULL, y=expression(PAR~(µmol~m^-2~s^-1))) +
theme_classic(base_size=13)
p5
p6 <- ggplot(env_monthly, aes(x=month, y=mean_SWC)) +
geom_line(color="#2196F3", linewidth=1.2) +
geom_point(color="#2196F3", size=2) +
scale_x_continuous(breaks=1:12, labels=month.abb) +
labs(x=NULL, y="SWC (m³/m³)") +
theme_classic(base_size=13)
p6
fig_schematic <- (p_temp | p4) / (p_light | p5) / (p_water | p6) +
plot_annotation(
title = "Applied ecophysiology curves to environmental data",
theme = theme(plot.title = element_text(size=16, face="bold"))
)
fig_schematic
getwd()
ggsave("schematic_bsc_curves.png",
fig_schematic, width=12, height=10, dpi=150)

filter(A>-0.1 & A<0.1) %>%
filter(slope>-0.0001 & slope<0.00011) %>%
ggplot(aes(x = Qin, y = A,
color=factor(change_id),
shape=Sample)) +
geom_point(size=2, alpha=0.7) +
#scale_color_cmocean(name="thermal") +
#xlim(15000,25000) +
#ylim(-3,0) +
ggtitle("carbon assimilation vs light for moss-dominated crusts") +
theme_classic()
cyano_light %>%
filter(A>-0.3 & A<1) %>%
filter(slope>-0.00035 & slope<0.00035) %>%
ggplot(aes(x = CO2_r, y = A, color = factor(change_id))) +
stat_summary(fun = mean, geom = "point", size = 2, alpha = 0.7) +
ggtitle("carbon assimilation vs CO2 for T3P1dkcy") +
theme_classic()
# Aggregated curve --------------------------------------------------------
library(viridis)
cyano_light_plot <- cyano_light %>%
filter(elapsed<70000) |>
filter(LeakPct==0) %>%
filter(A>-0.1 & A<0.1) %>%
filter(slope>-0.00015 & slope<0.00015) %>%
mutate(
light_round = round(Qin),
Sample = recode(Sample,
"CyanoA" = "Cyanobacteria A",
"CyanoB" = "Cyanobacteria B",
"CyanoC" = "Cyanobacteria C",
"CynaoG" = "Cyanobacteria G"),
Sample = factor(Sample)
) %>%
group_by(Sample, light_round) %>%
summarise(mean_A = mean(A, na.rm = TRUE), .groups = "drop") %>%
ggplot(aes(x = light_round,
y = mean_A,
shape = Sample,
group = Sample)) +
## rectangles
# geom_rect(
#   xmin = 0, xmax = 100,
#   ymin = -Inf, ymax = 0,
#   fill = "grey", alpha = 0.05,
#   inherit.aes = FALSE
# ) +
# geom_rect(
#   xmin = 100, xmax = 250,
#   ymin = -Inf, ymax = Inf,
#   fill = "#FFD966", alpha = 0.05,
#   inherit.aes = FALSE
# ) +
# geom_rect(
#   xmin = 250, xmax = Inf,
#   ymin = -Inf, ymax = Inf,
#   fill = "darkorange", alpha = 0.05,
#   inherit.aes = FALSE
# ) +
geom_hline(yintercept = 0, linewidth = 0.4) +
## POINTS — color mapping
geom_point(aes(color = light_round), size = 10) +
#
#geom_line(aes(group=Sample),linewidth=0.3, linetype="dashed", color="black") +
## species-specific
geom_smooth(aes(group=Sample),
method = "loess",
linetype = "dashed",
linewidth = 0.4,
color = "black",
se = FALSE) +
## your formatting
scale_color_viridis_c(option = "plasma", end = 0.9) +
scale_shape_manual(values = c(16, 17, 18), name = "Species") +
ggtitle("mean carbon assimilation vs light (μmol photons m^-2 s^-1) for dryland lichen crusts (n=3)") +
labs(x="Light Level (μmol photons m^-2 s^-1)",
y="Mean Carbon Assimilation (μmol CO2 m^-2 s^-1)",
color="Light Level (μmol photons m^-2 s^-1)") +
theme_classic() +
theme(
axis.title = element_text(size=30),
axis.text = element_text(size=30),
plot.title = element_text(size=30),
legend.title = element_text(size=30),
legend.text = element_text(size=20),
legend.position.inside = c(0.75, 0.04),
legend.justification = c(0.5, 0),
legend.direction = "vertical",
legend.box = "vertical",
legend.background = element_rect(fill = "white", color = NA)
)
cyano_light_plot
ggsave("cyano_light.png", cyano_light_plot, width=20, height=20, dpi=600)

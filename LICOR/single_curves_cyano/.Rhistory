cyano_light <- bind_rows(cyano_B, cyano_G)
## visualizing how A changes over time
cyano_light %>%
filter(1>A & A >-1) %>%
ggplot(aes(x = elapsed, y = A, color=Qin)) +
geom_point() +
scale_y_continuous(n.breaks = 5)
cyano_light <- cyano_light |>
filter(LeakPct==0) |>
#filter(Qin==0 | Qin>795) |>
#mutate(light_level = case_when(Qin==0 ~ "dark",
#Qin>795~ "light") |>
mutate(delta_Qin = abs(Qin - lag(Qin)),
delta_CO2_r = abs(CO2_r - lag(CO2_r)),
env_change = delta_Qin > 50 | delta_CO2_r > 50) |>
mutate(change_id = cumsum(replace_na(env_change, FALSE))+1) |>
group_by(change_id) |>
mutate(time_since_change = elapsed - first(elapsed)) |>
ungroup()
cyano_light %>% #raw data
filter(A>-1 & A<1) %>%
ggplot() +
geom_point(aes(x=elapsed, y=A, color=env_change))
cyano_light %>%  #color codes by level
filter(LeakPct==0) %>%
filter(A>-0.1 & A<1) %>%
filter(elapsed<20000) %>%
#filter(A>-0.5 & A<1) %>%
ggplot(aes(x = elapsed, y = A, color=factor(change_id))) +
geom_point(size=1, alpha=0.5) +
theme_classic()
# Grouping A by Environmental Changes -------------------------------------
cyano_light %>%
filter(LeakPct==0) %>%
filter(A>-0.1 & A<0.1) %>%
ggplot(aes(x = elapsed, y = A, color=env_change)) +
geom_point() +
#geom_vline(aes(xintercept = time_elapsed), data = df %>% filter(env_change == TRUE),
# color = "red", linetype = "dashed") +
theme_classic()
# Rolling slope ----------------------------------------
rolling_slope <- function(x, y, width = 7) {
rollapplyr(1:length(y), width, function(i) {
coef(lm(y[i] ~ x[i]))[2]
}, fill = NA)
}
cyano_light <- cyano_light %>%
group_by(change_id) %>%
mutate(slope = rolling_slope(time_since_change, A)) %>%
ungroup()
cyano_light %>%
filter(LeakPct==0) %>%
filter(A>-0.1 & A<0.1) %>%
filter(elapsed <70000) %>%
#filter(A>-0.5 & A<0.15) %>%
ggplot(aes(x=elapsed, y=slope,
color=factor(change_id))) +
geom_point(size=2, alpha=0.7) +
theme_classic()
